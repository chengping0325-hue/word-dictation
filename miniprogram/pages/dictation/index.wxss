.page { padding: 0 28rpx 24rpx; }

.flex-input { flex: 1; font-size: 30rpx; color: var(--text-primary); }
.placeholder { color: var(--text-secondary); }

.empty-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  gap: 8rpx;
}
.empty-icon { font-size: 60rpx; }
.empty-text { font-size: 28rpx; color: var(--text-primary); }
.empty-sub { font-size: 22rpx; color: var(--text-secondary); }

.word-list {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.word-cell {
  padding: 22rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--separator);
  background: var(--bg-card);
  transition: transform 200ms, background 200ms;
}
.word-cell:last-child { border-bottom: none; }
.word-cell.dragging {
  background: #F2F2F7;
  transform: scale(1.02);
  z-index: 10;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.stepper {
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 4rpx 8rpx;
  gap: 8rpx;
}
.stp-btn {
  padding: 0 12rpx;
  font-size: 32rpx;
  color: var(--accent-blue);
}
.stp-val { min-width: 80rpx; text-align: center; font-size: 26rpx; }

.fab-wrap {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 50;
}
