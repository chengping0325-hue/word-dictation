<view class="manual-check">

  <view wx:if="{{ currentItem }}" class="question-card">
    <view class="q-head">
      <type-tag type="{{ currentItem.type }}" />
      <text class="q-num">第 {{ currentIndex + 1 }} / {{ total }} 题</text>
    </view>
    <view class="q-content">{{ currentItem.content }}</view>
    <view class="q-hint">请家长核对答卷上是否写对</view>
    <view class="q-buttons">
      <view class="btn-wrong" bindtap="onWrong">✗ 写错了</view>
      <view class="btn-correct" bindtap="onCorrect">✓ 写对了</view>
    </view>
  </view>

  <view wx:if="{{ checked.length > 0 }}" class="card">
    <view class="card-title">前面已核对 · {{ checked.length }} 条</view>
    <view wx:for="{{ checked }}" wx:key="content" class="word-item">
      <type-tag type="{{ item.type }}" />
      <view class="flex-1 c-text">{{ item.content }}</view>
      <view class="result-badge {{ item.isCorrect ? 'badge-ok' : 'badge-err' }}">{{ item.isCorrect ? '✓' : '✗' }}</view>
    </view>
  </view>

  <view class="skip-row" bindtap="onSkip">跳过此题 →</view>

</view>
