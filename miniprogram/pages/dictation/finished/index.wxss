page {
  background: transparent;
}

.finished-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #1e3a8a 0%, #2563EB 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 56rpx;
}

.custom-navbar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
}

.top-row {
  text-align: center;
  padding: 0 32rpx;
}
.progress-num {
  font-size: 30rpx;
  font-weight: 600;
  opacity: 0.9;
}

.center-area {
  padding: 96rpx 48rpx 0;
  text-align: center;
}

.check-circle {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}
.check-icon {
  font-size: 96rpx;
  color: #F59E0B;
  font-weight: 700;
  line-height: 1;
}

.big-title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.sub-title {
  font-size: 26rpx;
  opacity: 0.7;
  margin-bottom: 64rpx;
}

.next-card {
  background: rgba(255,255,255,0.12);
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
}
.next-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 28rpx;
  text-align: left;
}
.next-steps {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.step {
  text-align: center;
}
.step-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
  font-size: 36rpx;
}
.step-label {
  font-size: 20rpx;
  opacity: 0.7;
}
.step-arrow {
  font-size: 32rpx;
  opacity: 0.5;
}

.spacer { flex: 1; }

.bottom-buttons {
  padding: 0 32rpx;
}
.btn-grade {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  background: #F59E0B;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.btn-grade::after { border: none; }
.btn-manual {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: transparent;
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}
.btn-manual::after { border: none; }
