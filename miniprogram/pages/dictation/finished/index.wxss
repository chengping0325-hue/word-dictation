page {
  background: #1e3a8a;
}

.finished-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #1e3a8a 0%, #2563EB 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));  /* 项 5(a) 距底 ≥48px */
}

.top-row {
  text-align: center;
  padding: 24rpx 32rpx 0;
}
.progress-num {
  font-size: 30rpx;
  font-weight: 600;
  opacity: 0.9;
}

.center-area {
  padding: 96rpx 48rpx 0;
  text-align: center;
}

.check-circle {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}
.check-svg {
  width: 96rpx;             /* 原型 48px */
  height: 96rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='48' height='48' viewBox='0 0 24 24' fill='none' stroke='%23F59E0B' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}

.big-title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.sub-title {
  font-size: 26rpx;
  opacity: 0.7;
  margin-bottom: 64rpx;
}

.next-card {
  background: rgba(255,255,255,0.12);
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
}
.next-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 28rpx;
  text-align: left;
}
.next-steps {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.step {
  text-align: center;
}
/* 项 12：每个 step-icon 是 48x48 渐变圆角矩形 + 主体白色叠加 + 下方阴影 */
.step-icon {
  width: 96rpx;                /* 48px = 96rpx */
  height: 96rpx;
  margin: 0 auto 12rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
  filter: drop-shadow(0 6rpx 12rpx rgba(0,0,0,0.25));
}

/* 拍照:蓝色渐变 + 经典相机轮廓(主体+镜头+闪光灯) */
.step-icon-camera {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'><defs><linearGradient id='gc' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%2360a5fa'/><stop offset='1' stop-color='%232563eb'/></linearGradient></defs><rect x='2' y='2' width='44' height='44' rx='11' fill='url(%23gc)'/><path d='M14 18 h4 l2-3 h8 l2 3 h4 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 h-20 a2 2 0 0 1 -2 -2 v-12 a2 2 0 0 1 2 -2 z' fill='%23ffffff'/><circle cx='24' cy='26' r='5' fill='%232563eb'/><circle cx='24' cy='26' r='2.5' fill='%23ffffff'/><circle cx='32' cy='21' r='1' fill='%232563eb'/></svg>");
}

/* AI 识别:紫色渐变 + 文档(含文字行) + 右上 AI 星花徽章,贴近"OCR 识别"语义 */
.step-icon-ai {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'><defs><linearGradient id='ga' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23c084fc'/><stop offset='1' stop-color='%237e22ce'/></linearGradient></defs><rect x='2' y='2' width='44' height='44' rx='11' fill='url(%23ga)'/><path d='M11 12 h13 l6 6 v17 a2 2 0 0 1 -2 2 H13 a2 2 0 0 1 -2 -2 Z' fill='%23ffffff'/><path d='M24 12 v6 h6 Z' fill='%23e9d5ff'/><rect x='15' y='23' width='12' height='2' rx='1' fill='%23a855f7' opacity='0.55'/><rect x='15' y='27' width='9' height='2' rx='1' fill='%23a855f7' opacity='0.55'/><rect x='15' y='31' width='6' height='2' rx='1' fill='%23a855f7' opacity='0.55'/><circle cx='36' cy='14' r='6.5' fill='%23ffffff'/><path d='M36 9.5 L37.2 12.8 L40.5 14 L37.2 15.2 L36 18.5 L34.8 15.2 L31.5 14 L34.8 12.8 Z' fill='%237e22ce'/></svg>");
}

/* 看成绩：金色渐变 #fbbf24 → #d97706，奖杯 */
.step-icon-trophy {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'><defs><linearGradient id='gt' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23fbbf24'/><stop offset='1' stop-color='%23d97706'/></linearGradient></defs><rect x='2' y='2' width='44' height='44' rx='8' ry='8' fill='url(%23gt)'/><path d='M16 10 h16 v8 a8 8 0 0 1 -16 0 z' fill='%23ffffff' opacity='0.95'/><path d='M16 12 h-3 a2 2 0 0 0 -2 2 v2 a4 4 0 0 0 4 4 h1' fill='none' stroke='%23ffffff' stroke-width='2' opacity='0.85'/><path d='M32 12 h3 a2 2 0 0 1 2 2 v2 a4 4 0 0 1 -4 4 h-1' fill='none' stroke='%23ffffff' stroke-width='2' opacity='0.85'/><rect x='22' y='26' width='4' height='6' fill='%23ffffff' opacity='0.9'/><rect x='17' y='32' width='14' height='4' rx='1' fill='%23ffffff'/></svg>");
}

.step-label {
  font-size: 22rpx;            /* 项 12 文案要求 11px */
  color: rgba(255,255,255,0.85);
}
.step-arrow {
  font-size: 32rpx;
  opacity: 0.5;
}

.spacer { flex: 1; }

.bottom-buttons {
  padding: 0 32rpx;
}
.btn-grade {
  width: 100%;
  height: 100rpx;
  border-radius: 28rpx;
  background: #F59E0B;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;       /* 项 5(c) 上下间距 12px = 24rpx */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn-manual {
  width: 100%;
  height: 88rpx;
  border-radius: 28rpx;
  background: transparent;
  color: rgba(255,255,255,0.85);
  font-size: 30rpx;            /* 项 9 次按钮 13→15px */
  font-weight: 500;
  border: 1rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
