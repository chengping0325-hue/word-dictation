<view class="result-page">

  <!-- 分数卡 -->
  <view class="score-card">
    <view class="score-label-top">本次得分</view>
    <view class="score-num">{{ score.correct }} / {{ score.total }}</view>
    <view class="score-sub">
      正确率 {{ rateText }}%
      <text wx:if="{{ wrongCount > 0 }}"> · {{ wrongCount }} 处需要注意</text>
    </view>
  </view>

  <!-- 识别结果 -->
  <view class="card">
    <view class="card-title">识别结果</view>

    <view wx:for="{{ items }}" wx:key="content"
          class="result-item {{ item.type === 'en_sentence' || item.type === 'cn_sentence' ? 'with-sentence' : 'compact' }}">
      <type-tag type="{{ item.type }}" />

      <view class="flex-1 result-body">
        <!-- 第一行:OCR 识别到的内容(整句红/黑,不做词级 diff) -->
        <view wx:if="{{ item.userAnswer }}"
              class="result-word {{ item.isCorrect ? '' : 'wrong' }} {{ (item.type === 'en_sentence' || item.type === 'cn_sentence') ? 'sentence' : '' }}">{{ item.userAnswer }}</view>
        <view wx:else class="result-word not-found">未识别到</view>

        <!-- 第二行:始终显示正确答案 -->
        <view class="correction">
          <text class="correction-label">正确答案:</text>
          <text class="good-text">{{ item.content }}</text>
        </view>
      </view>

      <view class="result-badge tappable {{ item.isCorrect ? 'badge-ok' : 'badge-err' }}"
            data-index="{{ index }}"
            bindtap="onToggleCorrect">
        {{ item.isCorrect ? '✓ 正确' : '✗ 错误' }}
      </view>
    </view>
  </view>

  <view class="tip-card">
    <view class="tip-head">💡 已存入单词本</view>
    <view class="tip-body">本次听写结果已记录,可在单词本查看与复习。</view>
  </view>

  <view class="bottom-buttons">
    <view class="btn-row">
      <view class="btn-secondary" bindtap="onRetry">重新听写</view>
      <view class="btn-secondary {{ wrongCount === 0 ? 'disabled' : '' }}"
            bindtap="onRetryWrong">重新听写错词</view>
      <view class="btn-blue" bindtap="onViewNotebook">查看单词本</view>
    </view>
  </view>

</view>
