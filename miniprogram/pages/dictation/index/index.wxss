.dictation-index {
  min-height: 100vh;
  background: #EFF6FF;
  padding-top: 8rpx;
}

/* 添加内容 */
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-wrap {
  flex: 1;
  min-width: 0;             /* 必须，否则 flex 子元素的最小宽度按 input 内容算 */
  display: flex;
  gap: 12rpx;
  align-items: center;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  border: 1rpx solid #E4ECFC;
  height: 96rpx;            /* 原型 48px = 96rpx */
  box-sizing: border-box;
}
.input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #0F172A;
  height: 80rpx;            /* 原型 40px */
}
.camera-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.camera-icon-svg {
  width: 34rpx;             /* 原型 svg 17x17 */
  height: 34rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='17' height='17' viewBox='0 0 24 24' fill='none' stroke='%23a21caf' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}
.add-btn {
  flex-shrink: 0;
  height: 96rpx;            /* 与输入胶囊同高 */
  line-height: 96rpx;
  padding: 0 32rpx;         /* 原型 16px */
  border-radius: 20rpx;     /* 原型 10px */
  background: #2563EB;
  color: #fff;
  font-size: 28rpx;         /* 原型 14px */
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.25);
}
.input-hint-row {
  margin-top: 16rpx;
  min-height: 32rpx;
}
.input-hint {
  font-size: 22rpx;
  color: #94a3b8;
}
.preview-tag-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.preview-hint {
  font-size: 22rpx;
  color: #64748b;
}

/* 列表 */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.clear-all {
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 600;
}

/* ── 拖拽列表 ── */
.drag-list {
  position: relative;
}
.drag-item {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0;
  border-bottom: 1rpx solid #f1f5fd;
  box-sizing: border-box;
  background: #fff;
  will-change: transform;
}
.drag-item:last-child { border-bottom: none; }

.drag-item .drag-handle {
  width: 40rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 28rpx;
  flex-shrink: 0;
}
.drag-item .word-text {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
}
.drag-item .word-text.sentence {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}
.drag-item .word-del {
  width: 40rpx;
  height: 40rpx;
  padding: 20rpx;
  box-sizing: content-box;
  margin: -20rpx -20rpx -20rpx 0;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.drag-item.dragging {
  background: #f8fafc;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.18);
  border-radius: 16rpx;
  border-bottom: none;
  transform-origin: center;
}
.drag-item.dragging .drag-handle { color: #2563EB; }

.empty {
  padding: 64rpx 0;
  text-align: center;
}
.empty-icon-svg {
  width: 80rpx;             /* 原型 40px */
  height: 80rpx;
  margin: 0 auto 24rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 24 24' fill='none' stroke='%23bfdbfe' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20h9'/><path d='M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 设置 */
.card-disabled { opacity: 0.45; }

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.setting-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
}
.setting-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EFF6FF;
  border: 3rpx solid #bfdbfe;
  color: #2563EB;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-sizing: border-box;
}
.stepper-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  min-width: 56rpx;
  text-align: center;
}
