.dictation-index {
  min-height: 100vh;
  background: #EFF6FF;
  padding-top: 8rpx;
}

/* 添加内容 */
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-wrap {
  flex: 1;
  display: flex;
  gap: 12rpx;
  align-items: center;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  border: 1rpx solid #E4ECFC;
  height: 80rpx;
  box-sizing: border-box;
}
.input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #0F172A;
  height: 64rpx;
}
.camera-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #fdf4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.camera-icon {
  font-size: 32rpx;
}
.add-btn {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  background: #2563EB;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.25);
  margin: 0;
}
.add-btn::after { border: none; }
.input-hint-row {
  margin-top: 16rpx;
  min-height: 32rpx;
}
.input-hint {
  font-size: 22rpx;
  color: #94a3b8;
}
.preview-tag-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.preview-hint {
  font-size: 22rpx;
  color: #64748b;
}

/* 列表 */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.clear-all {
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 600;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
  color: #bfdbfe;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 设置 */
.card-disabled { opacity: 0.45; }

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.setting-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
}
.setting-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EFF6FF;
  border: 3rpx solid #bfdbfe;
  color: #2563EB;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-sizing: border-box;
}
.stepper-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  min-width: 56rpx;
  text-align: center;
}
