.dictation-index {
  /* 三段式布局：Page 本身不滚动，中间 scroll-view 独立滚动。
     好处：滚动条落在内容区，不会压到底部固定的 Tab 栏上。

     高度用 100% 而不是 100vh：100vh 是整个屏幕高，
     而本页用原生导航栏（页面内容区 = 屏幕 - 状态栏 - 导航栏），
     用 100vh 会让底部 Tab 栏被推到屏幕外。
     page-meta 的 page-style 已把 page 高度收敛到内容区（height:100% +
     overflow:hidden），这里 height:100% 让根节点填满它。

     不用 position:fixed 撑满 —— fixed 根节点在部分场景下会让
     scroll-view 的滚动位置计算异常，表现为「滑不到顶部」。 */
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #EFF6FF;
}

/* 内容滚动区：flex:1 + height:0 自动填满剩余高度（Tab 栏高度已被扣掉）。
   height:0 是 flex 子项填满剩余空间的标准写法 —— 只写 flex:1 时，
   scroll-view 的初始高度是内容高度，flex 压缩不生效会导致不滚动。 */
.dictation-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* 滚动内容的内边距：
   顶部 —— 替代原根节点的 padding-top
   底部 —— 留出足够空间，让「问题反馈」离底部 Tab 栏有呼吸感，
           滚到底时也不会紧贴 Tab 栏。

           数值构成：Tab 栏可视区 110rpx + 视觉余量 80rpx + safe-area。
           Tab 栏是 fixed 在视口底部，内容滚到底时最后一行会滑到它下面，
           必须留出这段高度才看得见。

           注意：min-height（用于空清单回弹）与这个 padding 是两套机制，
           min-height 撑起的是「内容整体高度」，padding 是「内容下方的留白」。
           两者叠加会让空清单时底部出现大片空白，所以
           BOUNCE_EXTRA_RPX 保持小值（只够拉出一点弹性）。 */
.dictation-content {
  padding-top: 8rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

/* 添加内容 */
.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.input-wrap {
  flex: 1;
  min-width: 0;             /* 必须，否则 flex 子元素的最小宽度按 input 内容算 */
  display: flex;
  gap: 12rpx;
  align-items: center;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  border: 1rpx solid #E4ECFC;
  height: 96rpx;            /* 原型 48px = 96rpx */
  box-sizing: border-box;
}
.input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #0F172A;
  height: 80rpx;            /* 原型 40px */
}
.camera-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.camera-icon-svg {
  width: 38rpx;
  height: 38rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232563EB' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}
.add-btn {
  flex-shrink: 0;
  height: 96rpx;            /* 与输入胶囊同高 */
  line-height: 96rpx;
  padding: 0 32rpx;         /* 原型 16px */
  border-radius: 20rpx;     /* 原型 10px */
  background: #2563EB;
  color: #fff;
  font-size: 28rpx;         /* 原型 14px */
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.25);
}
.input-hint-row {
  margin-top: 16rpx;
  min-height: 32rpx;
}
.input-hint {
  font-size: 22rpx;
  color: #94a3b8;
}
.preview-tag-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.preview-hint {
  font-size: 22rpx;
  color: #64748b;
}

/* 列表 */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.clear-all {
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 600;
}

/* ── 拖拽列表 ── */
.drag-list {
  position: relative;
}
.drag-item {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0;
  border-bottom: 1rpx solid #f1f5fd;
  box-sizing: border-box;
  background: #fff;
  will-change: transform;
}
.drag-item:last-child { border-bottom: none; }

.drag-item .drag-handle {
  width: 40rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 28rpx;
  flex-shrink: 0;
}
/* 单词和句子样式强制完全一致(防止任何 sentence 类的继承覆盖) */
.drag-item .word-text,
.drag-item .word-text.sentence {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
  line-height: 1.4;
}
.drag-item .word-del {
  width: 40rpx;
  height: 40rpx;
  padding: 20rpx;
  box-sizing: content-box;
  margin: -20rpx -20rpx -20rpx 0;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.drag-item.dragging {
  background: #f8fafc;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.18);
  border-radius: 16rpx;
  border-bottom: none;
  transform-origin: center;
}
.drag-item.dragging .drag-handle { color: #2563EB; }

.empty {
  padding: 64rpx 0;
  text-align: center;
}
.empty-icon-svg {
  width: 80rpx;             /* 原型 40px */
  height: 80rpx;
  margin: 0 auto 24rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 24 24' fill='none' stroke='%23bfdbfe' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20h9'/><path d='M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 设置 */
.card-disabled { opacity: 0.45; }

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.setting-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
}
.setting-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EFF6FF;
  border: 3rpx solid #bfdbfe;
  color: #2563EB;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-sizing: border-box;
}
.stepper-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  min-width: 56rpx;
  text-align: center;
}

/* ── 问题反馈入口 ── */
/* 纯文字链接：蓝色文字居中，无图标、无胶囊底色 */
.feedback-entry {
  margin: 32rpx 0 0;
  text-align: center;
  font-size: 26rpx;
  color: #2563EB;
  letter-spacing: 1rpx;
  /* 上下留一点 padding，扩大可点热区，视觉上仍是纯文字 */
  padding: 8rpx 32rpx;
}

.feedback-entry:active {
  opacity: 0.6;
}
