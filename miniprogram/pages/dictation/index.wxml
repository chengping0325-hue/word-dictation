<view class="page">

  <!-- 添加单词 -->
  <view class="section-label">添加单词</view>
  <view class="group">
    <view class="group-row">
      <input class="flex-input"
        value="{{inputWord}}"
        placeholder="输入单词（中/英）"
        placeholder-class="placeholder"
        confirm-type="done"
        bindinput="onInput"
        bindconfirm="addWord" />
      <text class="accent" bindtap="addWord">添加</text>
    </view>
    <view class="group-row" bindtap="photoOCR">
      <text>📷 拍照识别</text>
      <text class="accent">›</text>
    </view>
  </view>

  <!-- 单词列表 -->
  <view class="section-label">单词列表 · {{words.length}} 个</view>
  <view wx:if="{{words.length === 0}}" class="group empty-row">
    <text class="empty-icon">✏️</text>
    <text class="empty-text">还没有单词</text>
    <text class="empty-sub">手动输入或拍照上传开始</text>
  </view>

  <view wx:else class="word-list">
    <view wx:for="{{words}}" wx:key="*this"
      class="word-cell {{dragIndex === index ? 'dragging' : ''}}"
      data-index="{{index}}"
      bindlongpress="startDrag"
      bindtouchmove="onDrag"
      bindtouchend="endDrag">
      <text class="word-text">{{item}}</text>
      <text class="danger" catchtap="deleteWord" data-index="{{index}}">删除</text>
    </view>
  </view>

  <!-- 朗读设置 -->
  <view class="section-label">朗读设置</view>
  <view class="group">
    <view class="group-row">
      <text>朗读次数</text>
      <view class="stepper">
        <text class="stp-btn" bindtap="decPlayCount">−</text>
        <text class="stp-val">{{playCount}} 次</text>
        <text class="stp-btn" bindtap="incPlayCount">+</text>
      </view>
    </view>
    <view class="group-row">
      <text>间隔时间</text>
      <view class="stepper">
        <text class="stp-btn" bindtap="decInterval">−</text>
        <text class="stp-val">{{interval}} 秒</text>
        <text class="stp-btn" bindtap="incInterval">+</text>
      </view>
    </view>
  </view>

  <view style="height: 220rpx;"></view>

  <view class="fab-wrap">
    <button class="btn-primary" disabled="{{words.length === 0}}" bindtap="startDictation">
      开始听写
    </button>
  </view>

  <inner-tabbar active="listen" />
</view>
