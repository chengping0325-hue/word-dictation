<view class="playing-page">

  <!-- 顶部栏:进度数字居中(微信原生导航栏在上方,不需要自己画) -->
  <view class="top-row">
    <view class="progress-num">{{ currentIndex + 1 }} / {{ total }}</view>
  </view>

  <view class="progress-bars">
    <view wx:for="{{ progressBars }}" wx:key="*this"
          class="progress-bar-seg {{ item }}"></view>
  </view>

  <view class="center-area">
    <view class="type-pill">
      <text class="type-pill-label">{{ typeLabel }}</text>
    </view>

    <view class="sound-circle">
      <view wx:if="{{ isPlaying }}" class="ripple ripple1"></view>
      <view wx:if="{{ isPlaying }}" class="ripple ripple2"></view>
      <view class="speaker-svg"></view>
    </view>

    <view class="read-progress">
      <view class="dots">
        <view wx:for="{{ readDots }}" wx:key="*this"
              class="dot {{ item ? 'active' : '' }}"></view>
      </view>
      <view class="read-meta">
        <text wx:if="{{ isGenerating }}">正在准备音频…</text>
        <text wx:elif="{{ isPaused }}">已暂停</text>
        <text wx:elif="{{ isWaitingInterval }}">间隔等待中…</text>
        <text wx:else>第 {{ readCurrent }} 次 / 共 {{ readCount }} 次</text>
      </view>
    </view>
  </view>

  <view class="spacer"></view>

  <view class="controls">
    <view class="ctrl-btn" bindtap="onReplay">
      <view class="ctrl-icon ctrl-icon-replay"></view>
      <view class="ctrl-label">重听</view>
    </view>
    <view class="ctrl-btn primary" bindtap="onTogglePause">
      <view class="ctrl-icon {{ isPaused ? 'ctrl-icon-play' : 'ctrl-icon-pause' }}"></view>
      <view class="ctrl-label">{{ isPaused ? '继续' : '暂停' }}</view>
    </view>
    <view class="ctrl-btn" bindtap="onNext">
      <view class="ctrl-icon ctrl-icon-next"></view>
      <view class="ctrl-label">下一个</view>
    </view>
  </view>

</view>
