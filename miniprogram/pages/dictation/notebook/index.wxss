.notebook-page {
  min-height: 100vh;
  background: #EFF6FF;
  padding-top: 8rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 0;
}
.filter-tab {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
.filter-tab.active {
  background: #2563EB;
  color: #fff;
}

.session-head {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2563EB;
  background: #EFF6FF;
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}
.session-head .dot { color: #cbd5e1; }

.word-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5fd;
}
.word-item.with-sentence { align-items: flex-start; }
.word-item:last-child { border-bottom: none; }

.word-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
}
.word-text.sentence {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}
.word-text.wrong { color: #dc2626; }

.wrong-hint {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
.wrong-hint::after { content: ''; }

.re-dictate-wrap {
  padding: 24rpx 32rpx 0;
}
.btn-ghost {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 3rpx solid #bfdbfe;
  color: #2563EB;
  font-size: 26rpx;
  font-weight: 600;
}
.btn-ghost::after { border: none; }
