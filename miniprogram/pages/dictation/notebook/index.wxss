/* ── 三段式布局 ──
   Page 不滚动，中间 scroll-view 独立滚动。
   好处：顶部标题栏固定在视口顶部（滚动时标题不跟着走），
   滚动条落在内容区，不会压到标题栏或底部 Tab 栏。 */
.notebook-root {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #EFF6FF;
}

/* 顶部固定栏：状态栏占位 + 标题行
   z-index 高于 Tab 栏(100)，保证滚动内容从标题栏下方穿过时被遮挡 */
.notebook-navbar {
  flex-shrink: 0;
  z-index: 101;
  background: #fff;
  box-sizing: border-box;
}

.notebook-navbar__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.notebook-navbar__title {
  color: #000;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}

/* 内容滚动区：flex:1 自动填满剩余高度（Tab 栏高度已被扣掉） */
.notebook-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* 滚动内容：顶部留白 + 底部 Tab 栏高度 */
.notebook-content {
  padding-top: 8rpx;
}

/* 项 7：iOS 风格胶囊分段控件 */
.segmented-wrap {
  padding: 24rpx 32rpx 0;
}
.segmented {
  display: flex;
  background: #CBD5E1;      /* 加深灰底,跟白色选中态对比更明显 */
  border-radius: 20rpx;
  padding: 6rpx;
  box-sizing: border-box;
}
.segment {
  flex: 1;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #475569;            /* 未选中文字也加深一点 */
  transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
}
.segment.active {
  background: #fff;
  color: #0F172A;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

/* 日期组卡片头 */
.session-head {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;        /* 项 9 类别 B：日期组摘要 11→13px */
  font-weight: 600;
  color: #2563EB;
  background: #EFF6FF;
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
  margin-bottom: 16rpx;
}
.session-head .dot { color: #cbd5e1; }

/* 单词本条目 */
.word-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5fd;
}
.word-item.with-sentence { align-items: flex-start; }
.word-item:last-child { border-bottom: none; }

/* 单词和句子样式强制一致 */
.word-text,
.word-text.sentence {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
  line-height: 1.5;
}
.word-text.wrong { color: #dc2626; }

.wrong-hint {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* loading / error / empty 占位块 */
.state-block {
  padding: 120rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}
.state-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 8rpx;
}
.state-sub {
  font-size: 24rpx;
  color: #94a3b8;
}
.btn-retry {
  margin-top: 32rpx;
  height: 72rpx;
  padding: 0 48rpx;
  border-radius: 18rpx;
  background: #2563EB;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 项 8(d)：卡片底部"重新听写"按钮 */
.card-action {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f5fd;
}
.btn-card-action {
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 3rpx solid #bfdbfe;
  color: #2563EB;
  font-size: 30rpx;          /* 项 9 次按钮 15px */
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
