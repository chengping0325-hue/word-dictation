.page { padding: 0 28rpx 24rpx; }

/* Upload state */
.upload-zone {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 80rpx 40rpx;
  text-align: center;
  border: 3rpx dashed var(--border);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.up-ic { font-size: 80rpx; }
.up-t { font-size: 30rpx; color: var(--text-primary); font-weight: 500; }
.up-h { font-size: 22rpx; color: var(--text-secondary); }

.word-preview {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}
.wp-t { display: block; font-size: 24rpx; color: var(--text-secondary); margin-bottom: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 8rpx; }
.chip {
  background: #F2F2F7;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-chip);
  font-size: 24rpx;
}

/* Loading state */
.loading-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 60rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
}
.spinner {
  width: 56rpx; height: 56rpx;
  border: 5rpx solid var(--separator);
  border-top-color: var(--accent-blue);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { 100% { transform: rotate(360deg); } }
.ld-t { display: block; font-size: 28rpx; color: var(--text-primary); }
.ld-h { display: block; font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }

/* Result state */
.score-card {
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
  color: #fff;
  border-radius: var(--radius-card);
  padding: 40rpx;
  text-align: center;
  margin-top: 16rpx;
}
.sc-label { display: block; font-size: 22rpx; opacity: 0.8; }
.sc-num { display: block; font-size: 76rpx; font-weight: 600; line-height: 1; margin: 8rpx 0; }
.sc-pct { display: block; font-size: 24rpx; opacity: 0.8; }

.result-left { display: flex; flex-direction: column; }
.result-word { font-size: 30rpx; }
.result-word.danger { color: var(--danger); font-weight: 500; }
.result-sub { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; }
.badge { font-size: 32rpx; font-weight: 600; }
.badge.ok { color: var(--success); }
.badge.no { color: var(--danger); }

.fab-wrap {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 50;
}
