<view class="page">

  <!-- 状态 1：上传 -->
  <block wx:if="{{state === 'upload'}}">
    <view class="section-label">上传手写答卷</view>
    <view class="upload-zone" bindtap="uploadAnswer">
      <text class="up-ic">📷</text>
      <text class="up-t">拍照 / 从相册选择</text>
      <text class="up-h">拍下你刚才听写的纸张</text>
    </view>

    <view class="section-label">本次听写</view>
    <view class="word-preview">
      <text class="wp-t">共 {{words.length}} 个单词，正在等你的答卷…</text>
      <view class="chips">
        <view wx:for="{{words}}" wx:key="*this" class="chip">{{item}}</view>
      </view>
    </view>
  </block>

  <!-- 状态 2：OCR 识别中 -->
  <block wx:elif="{{state === 'loading'}}">
    <view class="section-label">识别中</view>
    <view class="loading-card">
      <view class="spinner"></view>
      <text class="ld-t">正在识别手写内容</text>
      <text class="ld-h">微信 OCR 处理中…</text>
    </view>
  </block>

  <!-- 状态 3：结果 -->
  <block wx:elif="{{state === 'result'}}">
    <view class="score-card">
      <text class="sc-label">本次得分</text>
      <text class="sc-num">{{correctCount}} / {{words.length}}</text>
      <text class="sc-pct">正确率 {{scorePercent}}%</text>
    </view>

    <view class="section-label">对比结果</view>
    <view class="group">
      <view wx:for="{{results}}" wx:key="index" class="group-row">
        <view class="result-left">
          <text class="result-word {{item.correct ? '' : 'danger'}}">{{item.original}}</text>
          <text wx:if="{{!item.correct}}" class="result-sub">你写了「{{item.written}}」</text>
        </view>
        <text class="badge {{item.correct ? 'ok' : 'no'}}">{{item.correct ? '✓' : '✗'}}</text>
      </view>
    </view>

    <view style="height: 200rpx;"></view>

    <view class="fab-wrap">
      <button class="btn-primary" bindtap="finish">完成，查看单词本</button>
    </view>
  </block>

</view>
