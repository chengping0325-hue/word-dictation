.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EEF1FB 0%, #E3EAFB 100%);
  padding: 32rpx 0 48rpx;
  box-sizing: border-box;
}

.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
}

.tool-card {
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx 32rpx 32rpx;
  aspect-ratio: 1 / 1.1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(37, 99, 235, 0.06);
  position: relative;
  box-sizing: border-box;
}
.tool-card.disabled { opacity: 0.7; }
.tool-card.placeholder {
  background: rgba(255, 255, 255, 0.5);
  border: 3rpx dashed #cbd5e1;
  box-shadow: none;
}

.tool-icon {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 96rpx;
  line-height: 1;
}

.tool-plus {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #cbd5e1;
  font-weight: 300;
  margin-bottom: 24rpx;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 8rpx;
}
.tool-name.muted { color: #64748b; }

.tool-desc {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.tool-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(148, 163, 184, 0.18);
  color: #64748b;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.tool-badge.hot {
  background: #fef3c7;
  color: #92400e;
}

.home-footer {
  text-align: center;
  padding: 72rpx 32rpx 0;
  font-size: 22rpx;
  color: #94a3b8;
}
