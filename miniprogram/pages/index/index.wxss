.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 48rpx; }
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: var(--color-fg); }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; overflow: hidden; background: var(--color-primary); }
.avatar-img { width: 72rpx; height: 72rpx; }
.grid { padding: 24rpx 32rpx; }
.row { display: flex; flex-direction: row; margin-bottom: 24rpx; }
.gap { width: 24rpx; flex-shrink: 0; }
.tool-card-placeholder { flex: 1; }
