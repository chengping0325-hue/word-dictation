<view class="page">
  <view class="header">
    <text class="title">口袋工具</text>
    <view class="avatar" bindtap="goProfile">
      <image src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" />
    </view>
  </view>

  <view class="grid">
    <view class="row">
      <tool-card icon="🎧" name="单词听写" desc="英语听写练习" path="/pages/dictation/index" />
      <view class="gap" />
      <tool-card icon="📚" name="城市书斋" desc="书籍管理" disabled="{{true}}" />
    </view>
    <view class="row">
      <tool-card icon="＋" name="更多工具" desc="陆续上线中" disabled="{{true}}" />
      <view class="gap" />
      <view class="tool-card-placeholder" />
    </view>
  </view>
</view>
