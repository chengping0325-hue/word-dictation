<view class="page">
  <view class="topbar">
    <text class="progress">{{currentIndex + 1}} / {{words.length}}</text>
    <view class="eye-btn" bindtap="toggleShow">
      <text class="eye">{{showWord ? '👁‍🗨' : '👁'}}</text>
    </view>
  </view>

  <view class="center">
    <text class="counter">单词 {{currentIndex + 1}} / {{words.length}}</text>

    <view class="speaker {{isPlaying ? 'pulse' : ''}}">
      <text class="speaker-ic">🔊</text>
    </view>

    <view class="word-display">
      <text wx:if="{{showWord}}" class="word-shown">{{words[currentIndex]}}</text>
      <text wx:else class="word-hidden">{{hiddenMask}}</text>
    </view>

    <text class="play-stat">正在播放第 {{playingCount}} / {{playCount}} 次</text>

    <view class="dots">
      <view wx:for="{{dotsArray}}" wx:key="index"
        class="dot {{index < playedCount ? 'done' : (index === playedCount ? 'active' : '')}}" />
    </view>

    <view wx:if="{{!isPlaying && countdown > 0}}" class="countdown">
      <text class="cd-num">{{countdown}}</text>
      <text class="cd-sub">秒后自动播放</text>
    </view>

    <view wx:if="{{finished}}" class="finished">听写完成 🎉</view>
  </view>

  <view class="pause-wrap">
    <button class="btn-pause" bindtap="togglePause">{{paused ? '继续' : '暂停'}}</button>
  </view>
</view>
