.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 28rpx 24rpx;
}

.topbar {
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.progress { font-size: 26rpx; color: var(--text-secondary); }
.eye-btn { padding: 8rpx 16rpx; }
.eye { font-size: 40rpx; color: var(--accent-blue); }

.center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.counter { font-size: 24rpx; color: var(--text-secondary); }

.speaker {
  width: 220rpx;
  height: 220rpx;
  border-radius: 110rpx;
  background: var(--accent-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-speaker);
  transition: transform 200ms;
}
.speaker-ic { font-size: 90rpx; color: #fff; }
.speaker.pulse { animation: pulse 1.5s infinite; }
@keyframes pulse {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.word-display {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 56rpx;
  box-shadow: var(--shadow-card);
}
.word-shown { font-size: 60rpx; font-weight: 600; color: var(--text-primary); }
.word-hidden { font-size: 60rpx; color: var(--border); letter-spacing: 16rpx; }

.play-stat { font-size: 24rpx; color: var(--text-primary); }

.dots { display: flex; gap: 12rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 8rpx; background: var(--border); }
.dot.done { background: var(--success); }
.dot.active { background: var(--accent-blue); }

.countdown { text-align: center; }
.cd-num { display: block; font-size: 88rpx; font-weight: 200; color: var(--text-primary); line-height: 1; }
.cd-sub { font-size: 22rpx; color: var(--text-secondary); }

.finished { font-size: 32rpx; color: var(--text-primary); font-weight: 600; }

.pause-wrap { padding: 24rpx 0 env(safe-area-inset-bottom); }
.btn-pause {
  background: var(--bg-card);
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-button);
  box-shadow: var(--shadow-card);
}
.btn-pause::after { border: none; }
