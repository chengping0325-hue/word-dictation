.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 48rpx; }
.card-title { font-size: 22rpx; font-weight: 700; color: var(--color-muted); text-transform: uppercase; letter-spacing: 1rpx; margin-bottom: 20rpx; }
.user-card { display: flex; flex-direction: column; align-items: center; padding: 64rpx 0 32rpx; }
.avatar { width: 128rpx; height: 128rpx; border-radius: 50%; margin-bottom: 20rpx; background: #E4ECFC; }
.nickname { font-size: 32rpx; font-weight: 700; }
.section-title { font-size: 22rpx; font-weight: 700; color: var(--color-muted); text-transform: uppercase; letter-spacing: 1rpx; padding: 8rpx 32rpx 0; }
.empty { padding: 48rpx; text-align: center; }
.empty-title { display: block; font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.empty-desc { font-size: 24rpx; color: var(--color-muted); }
.session-card { }
.session-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.session-date { font-size: 26rpx; font-weight: 700; color: var(--color-fg); }
.session-score { font-size: 22rpx; color: var(--color-primary); font-weight: 700; background: #EFF6FF; padding: 6rpx 18rpx; border-radius: 20rpx; }
.word-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.word-row:last-child { border-bottom: none; }
.word-name { font-size: 28rpx; font-weight: 700; margin-right: 16rpx; }
.word-name.wrong { color: var(--color-error); }
.correction { flex: 1; font-size: 22rpx; color: var(--color-muted); }
.badge { width: 48rpx; height: 48rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; flex-shrink: 0; }
.badge.ok { background: #DCFCE7; color: var(--color-success); }
.badge.err { background: #FEE2E2; color: var(--color-error); }
