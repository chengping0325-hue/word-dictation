.soon-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EEF1FB 0%, #E3EAFB 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}
.soon-illust {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}
.soon-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 16rpx;
}
.soon-sub {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
}
