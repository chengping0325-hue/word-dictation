/* app.wxss - 全局样式 */

page {
  background: #EFF6FF;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  color: #0F172A;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── 卡片 ── */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 24rpx 32rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.07);
}

.card-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

/* ── 主按钮（蓝色渐变） ── */
.btn-primary {
  display: block;
  width: calc(100% - 64rpx);
  margin: 28rpx 32rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2563EB, #3b82f6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.35);
}

.btn-primary[disabled],
.btn-primary.disabled {
  opacity: 0.45;
}

/* 微信原生 button 默认样式重置 */
.btn-primary::after {
  border: none;
}

/* ── 类型标签 ── */
.tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.tag-en { background: #dbeafe; color: #1e40af; }
.tag-cn { background: #fef3c7; color: #92400e; }
.tag-en-sent { background: #e0e7ff; color: #3730a3; }
.tag-cn-sent { background: #fce7f3; color: #9d174d; }

/* ── 提示卡片 ── */
.tip-card {
  background: #EFF6FF;
  border: 1rpx dashed #bfdbfe;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin: 20rpx 32rpx 0;
}
.tip-card .tip-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #0F172A;
  font-weight: 600;
}
.tip-card .tip-body {
  font-size: 22rpx;
  color: #475569;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ── 结果徽章 ── */
.result-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.badge-ok { background: #dcfce7; color: #16a34a; }
.badge-err { background: #fee2e2; color: #dc2626; }

/* ── 通用工具类 ── */
.flex-row { display: flex; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.text-center { text-align: center; }
.muted { color: #94a3b8; }

/* 滚动容器留出底部 Tab 高度 */
.has-tab-bar {
  padding-bottom: 140rpx;
}
