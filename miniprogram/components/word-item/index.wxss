.word-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;          /* 行高加大,适应 17px 字号 */
  border-bottom: 1rpx solid #f1f5fd;
}
.word-item.with-sentence { align-items: flex-start; }
.word-item.with-sentence .tag { margin-top: 4rpx; }
.word-item:last-child { border-bottom: none; }

.word-text {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;            /* 项 9 类别 A：清单条目 14→17px */
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
}
.word-text.sentence {
  font-size: 32rpx;            /* 句子稍小，保持 16px */
  font-weight: 500;
  line-height: 1.5;
}

.word-del {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
