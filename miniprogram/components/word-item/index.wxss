.word-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;          /* 行高保持紧凑 */
  border-bottom: 1rpx solid #f1f5fd;
}
.word-item.with-sentence { align-items: flex-start; }
.word-item.with-sentence .tag { margin-top: 4rpx; }
.word-item:last-child { border-bottom: none; }

.word-text {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;            /* 项 9 类别 A：清单条目 14→17px */
  font-weight: 600;
  color: #0F172A;
  word-break: break-word;
}
.word-text.sentence {
  font-size: 32rpx;            /* 句子稍小，保持 16px */
  font-weight: 500;
  line-height: 1.5;
}

/* × 关闭按钮:视觉图标小巧 40rpx,但 tap 区域扩到 80rpx(用 content-box + padding + 负 margin)
 * 这样行高不会被撑大,但点击区域足够 */
.word-del {
  width: 40rpx;
  height: 40rpx;
  padding: 20rpx;
  box-sizing: content-box;
  margin: -20rpx -20rpx -20rpx 0;
  border-radius: 50%;
  color: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.word-del:active { background: rgba(0,0,0,0.05); }
