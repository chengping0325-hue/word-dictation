/* Tab Bar：底部固定，可视区 110rpx + 下方 safe-area 留白 */
.dictation-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #E4ECFC;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

/* 可视区单独控制高度，保证图标 + 文字在视觉中央 */
.tab-row {
  height: 110rpx;
  display: flex;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.tab-item.active {
  color: #2563EB;
}
.tab-item.active .tab-label {
  font-weight: 600;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}

/* "听写" → 耳机图标(headphones) */
.tab-icon-speaker {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 18v-6a9 9 0 0 1 18 0v6'/><path d='M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z'/><path d='M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z'/></svg>");
}
.tab-icon-speaker.is-active {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232563EB' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 18v-6a9 9 0 0 1 18 0v6'/><path d='M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z'/><path d='M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z'/></svg>");
}

/* "单词本" → 笔记本图标(左侧装订线 + 内部 3 条线) */
.tab-icon-book {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='3' width='16' height='18' rx='2'/><line x1='8' y1='3' x2='8' y2='21'/><line x1='11' y1='8' x2='17' y2='8'/><line x1='11' y1='12' x2='17' y2='12'/><line x1='11' y1='16' x2='14' y2='16'/></svg>");
}
.tab-icon-book.is-active {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232563EB' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='3' width='16' height='18' rx='2'/><line x1='8' y1='3' x2='8' y2='21'/><line x1='11' y1='8' x2='17' y2='8'/><line x1='11' y1='12' x2='17' y2='12'/><line x1='11' y1='16' x2='14' y2='16'/></svg>");
}

.tab-label {
  letter-spacing: 1rpx;
}
