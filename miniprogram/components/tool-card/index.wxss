.tool-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: var(--shadow-card);
  transition: transform 150ms;
  position: relative;
}
.tool-card:active { transform: scale(0.97); }
.tool-card.disabled { opacity: 0.5; }
.icon { font-size: 50rpx; }
.name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.desc { font-size: 22rpx; color: var(--text-secondary); }
.soon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: var(--separator);
  color: var(--text-secondary);
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}
