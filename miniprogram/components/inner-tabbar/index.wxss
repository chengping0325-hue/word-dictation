.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 100rpx;
  display: flex;
  background: rgba(249, 249, 249, 0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--separator);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--text-secondary);
  font-size: 20rpx;
}
.tab.on { color: var(--accent-blue); }
.tab .ic { font-size: 36rpx; }
.tabbar-spacer { height: calc(100rpx + env(safe-area-inset-bottom)); }
